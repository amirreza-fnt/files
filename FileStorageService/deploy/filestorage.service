[Unit]
Description=File Storage Service (ASP.NET Core) - storage.sabzevar.ir
Documentation=https://storage.sabzevar.ir
Wants=network-online.target
After=network-online.target

[Service]
# simple (not notify): the app blocks at boot while Hangfire talks to the remote
# MSSQL, so there is no reliable sd_notify READY signal -> systemd would time out.
Type=simple
WorkingDirectory=/opt/filestorage
# Development mode for now so Swagger is reachable; switch to Production later.
Environment=ASPNETCORE_ENVIRONMENT=Development
# Service listens on port 6000
Environment=ASPNETCORE_URLS=http://127.0.0.1:6000
# Remote MSSQL connection string (server IP:port) - maps to ConnectionStrings:FileStorage
# NOTE: value contains spaces/;/# so it MUST be double-quoted for systemd to parse it correctly.
Environment=ConnectionStrings__FileStorage="Server=185.255.91.242,2019;Database=apiwebfilestorage;User Id=apiwebfilestorageuser;Password=54#4Fghkp0&g1;Encrypt=True;TrustServerCertificate=True;Connection Timeout=15;Connect Retry Count=3;Pooling=true;Max Pool Size=200;"
# Valkey connection (Redis-compatible) - maps to Valkey:ConnectionString
Environment=Valkey__ConnectionString=localhost:6379
# Production logging goes to journald + /var/log/filestorage
ExecStart=/usr/bin/dotnet /opt/filestorage/FileStorage.Api.dll
Restart=always
RestartSec=5
TimeoutStopSec=30
# Security hardening
User=filestorage
Group=filestorage
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/filestorage /var/log/filestorage
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target